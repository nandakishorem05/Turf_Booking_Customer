# Supabase Configuration
# Replace these with your project values from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Application URL (Update to your Vercel production domain)
NEXT_PUBLIC_APP_URL=https://your-customer-app.vercel.app

# Demo Mode Flag
# Set to "false" once real Supabase database schema and Razorpay keys are connected
# Set to "true" to run with built-in interactive demo mock data
NEXT_PUBLIC_DEMO_MODE=true
